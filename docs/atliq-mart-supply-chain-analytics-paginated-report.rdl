\"otif_perc\", \"ontime_target\", \"infull_target\", \"otif_target\", \"customer_id\"}),\r\n  #\"Removed columns\" = Table.RemoveColumns(#\"Reordered columns\", {\"customer_id\"}),\r\n  #\"Reordered columns 1\" = Table.ReorderColumns(#\"Removed columns\", {\"customer_name\", \"city\", \"total_orders\", \"ot_perc\", \"ontime_target\", \"if_perc\", \"infull_target\", \"otif_perc\", \"otif_target\"}),\r\n  #\"Added custom\" = Table.AddColumn(#\"Reordered columns 1\", \"ot_gap\", each [ot_perc] - [ontime_target]),\r\n  #\"Added custom 1\" = Table.AddColumn(#\"Added custom\", \"if_gap\", each [if_perc] - [infull_target]),\r\n  #\"Changed column type\" = Table.TransformColumnTypes(#\"Added custom 1\", {{\"ot_gap\", type number}, {\"if_gap\", type number}}),\r\n  #\"Added custom 2\" = Table.AddColumn(#\"Changed column type\", \"otif_gap\", each [otif_perc] - [otif_target]),\r\n  #\"Changed column type 1\" = Table.TransformColumnTypes(#\"Added custom 2\", {{\"otif_gap\", type number}})\r\n\r\nin\r\n  #\"Changed column type 1\";\r\n","ConnectionOverrides":[{"Path":"cjqm2juldonexiujgl75j3tyqq-dcuwt7vbdxjuriiq6fxb56scbq.datawarehouse.fabric.microsoft.com","Kind":"SQL","Provider":"DmtsFabric","AuthenticationKind":null,"EnvironmentName":null,"ApiName":null,"ConnectionName":"{\"ClusterId\":\"cca6d7be-36de-4779-bb93-49e14521038b\",\"DatasourceId\":\"184ecb4f-d3fe-4f85-8ede-35b0a6ca2158\"}","PrivacyGroup":"None","CredentialDetails":{},"Audience":null,"ConnectionParameters":{}}],"GatewayObjectId":null,"ParameterDefinitions":[]}</CommandText>
